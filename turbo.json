{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Every variable that changes build OUTPUT must be listed here. NEXT_PUBLIC_*
      // values are inlined into the client bundle at build time, so omitting them lets
      // turbo serve a bundle built against a different environment as a valid cache hit.
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "API_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_TRACES_SAMPLE_RATE",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV", "DATABASE_URL", "DATABASE_TEST_URL"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV", "DATABASE_URL", "DATABASE_TEST_URL"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["NODE_ENV", "DATABASE_URL", "DATABASE_TEST_URL"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
