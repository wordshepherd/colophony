{
  "name": "@colophony/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "default": "./dist/main.js"
    },
    "./trpc": {
      "default": "./dist/trpc/router.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint --max-warnings 0 \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:rls": "vitest run --config vitest.config.rls.ts",
    "test:security": "vitest run --config vitest.config.security.ts",
    "test:services": "vitest run --config vitest.config.services.ts",
    "test:webhooks": "vitest run --config vitest.config.webhooks.ts",
    "test:queues": "vitest run --config vitest.config.queues.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@colophony/api-contracts": "workspace:*",
    "@colophony/auth-client": "workspace:*",
    "@colophony/db": "workspace:*",
    "@colophony/plugin-sdk": "workspace:^",
    "@colophony/types": "workspace:*",
    "@fastify/compress": "8.3.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@orpc/openapi": "1.14.10",
    "@orpc/server": "1.14.10",
    "@orpc/zod": "1.14.10",
    "@sendgrid/mail": "8.1.6",
    "@sentry/node": "10.68.0",
    "@trpc/server": "11.18.0",
    "archiver": "7.0.1",
    "bullmq": "5.81.2",
    "clamscan": "2.4.0",
    "docx": "9.7.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-plugin": "5.1.0",
    "fastify-raw-body": "5.0.0",
    "htmlparser2": "12.0.0",
    "inngest": "4.13.0",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "mammoth": "1.12.0",
    "mjml": "5.4.0",
    "nodemailer": "9.0.3",
    "p-limit": "7.3.1",
    "prom-client": "15.1.3",
    "sanitize-html": "2.17.6",
    "stripe": "22.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@colophony/typescript-config": "workspace:*",
    "@eslint/js": "9.39.2",
    "@faker-js/faker": "10.5.0",
    "@types/archiver": "7.0.0",
    "@types/clamscan": "2.4.1",
    "@types/ioredis-mock": "8.2.7",
    "@types/mjml": "5.0.0",
    "@types/node": "26.1.2",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.20.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.8.0",
    "ioredis-mock": "8.13.1",
    "pg": "8.22.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
